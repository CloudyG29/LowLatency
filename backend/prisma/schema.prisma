// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  user_id       Int           @id @default(autoincrement())
  firebase_uid  String        @unique
  email         String        @unique
  name          String
  surname       String
  role          String        // "Admin", "Applicant", "Provider"
  
  // Relations
  applications  Application[]
  provider      Provider?     // A user might have a Provider profile
}

model Provider {
  provider_id   Int           @id @default(autoincrement())
  provider_name String
  profile       String?
  user_id       Int           @unique
  
  // The user this provider profile belongs to
  user          User          @relation(fields: [user_id], references: [user_id])
  
  // NEW: Listings now belong to the Provider profile
  listings      Listing[]     
  applications  Application[]
}

model Listing {
  listings_id   Int           @id @default(autoincrement())
  provider_id   Int
  listname      String
  list_type     String
  nqf_level     Int?
  description   String?
  status        String        @default("pending")

  provider      Provider      @relation(fields: [provider_id], references: [provider_id])
  // Add this so the Application model can link back to here
  applications  Application[] 
}

model Application {
  application_id Int      @id @default(autoincrement())
  user_id        Int
  listing_id     Int
  provider_id    Int
  cv             String
  status         String @default("pending")

  // We keep Cascade on the User (the Applicant)
  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  
  // We set NoAction on these two to break the circular/multiple path error
  listing  Listing  @relation(fields: [listing_id], references: [listings_id], onDelete: NoAction, onUpdate: NoAction)
  provider Provider @relation(fields: [provider_id], references: [provider_id], onDelete: NoAction, onUpdate: NoAction)
}
