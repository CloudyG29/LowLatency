generator client {
  provider = "prisma-client-js"
  output   = "../generated/client" 
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")

}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

