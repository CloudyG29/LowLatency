generator client {
  provider = "prisma-client-js"
  output   = "../generated/client" 
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")

}

model User {
  user_id      Int           @id @default(autoincrement())
  name         String
  surname      String
  role         String
  qualification String?

  listings     Listing[]
  applications Application[]
}

